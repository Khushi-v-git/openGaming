{
  // onlyGaming relay: a dumb forwarder. One Durable Object per room, SQLite-backed (required on
  // the free plan), WebSocket Hibernation API. No game logic lives here.
  "name": "onlygaming-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // Every limit can be changed here (all values are strings). See docs/relay.md.
  "vars": {
    "MAX_SOCKETS": "16",          // host + joiners per room
    "MAX_FRAME_CHARS": "65600",   // 64 KB protocol payload + routing header
    "HOST_GRACE_SEC": "60",       // how long a room waits for its host to reconnect
    "PING_SEC": "15",             // advised client keepalive interval
    "WATCHDOG_SEC": "45",         // advised client watchdog: no pong for this long = link dead
    "SWEEP_SEC": "30",            // relay alarm sweep interval
    "DEAD_SEC": "50",             // a socket with no keepalive for this long is dropped
    "HANDSHAKE_SEC": "5",         // a socket that never identifies itself is closed
    "IDLE_TTL_SEC": "10800",      // room with no real traffic for this long expires (3 h)
    "MAX_ROOM_AGE_SEC": "86400",  // absolute room lifetime (24 h)
    "PEER_RATE_BURST": "30",
    "PEER_RATE_PER_SEC": "20",
    "HOST_RATE_BURST": "200",
    "HOST_RATE_PER_SEC": "100",
    "MAX_VIOLATIONS": "20",
    "BUFFER_PER_PEER": "32",      // messages kept per joiner while the host is away
    "BUFFER_MAX_CHARS": "131072", // total characters kept while the host is away
    "BUFFER_ROOM_LIFETIME": "200",// buffered messages a room may ever write (caps row writes)
    "MAX_HOST_RESUMES": "20",     // host reconnects a room tolerates in its lifetime
    "ALLOW_FIXED_CODES": "0"      // "1" only in tests: /host?code=ABC234 picks the room code
  }

  // Optional, only if it works on your free account (see docs/relay.md):
  // "ratelimits": [{ "name": "JOIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
}
